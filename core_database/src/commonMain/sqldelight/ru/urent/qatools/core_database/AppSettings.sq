CREATE TABLE app_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    is_borderless_fullscreen INTEGER NOT NULL DEFAULT 0,
    ui_scale_percent INTEGER NOT NULL DEFAULT 100,
    theme TEXT NOT NULL DEFAULT 'LIGHT',
    is_sidebar_collapsed INTEGER NOT NULL DEFAULT 0,
    is_window_maximized INTEGER,
    window_x REAL,
    window_y REAL,
    window_width REAL,
    window_height REAL
);

selectSettings:
SELECT * FROM app_settings WHERE id = 1;

ensureSettingsRow:
INSERT OR IGNORE INTO app_settings(id) VALUES (1);

saveBorderlessFullscreen:
UPDATE app_settings SET is_borderless_fullscreen = ? WHERE id = 1;

saveUiScalePercent:
UPDATE app_settings SET ui_scale_percent = ? WHERE id = 1;

saveTheme:
UPDATE app_settings SET theme = ? WHERE id = 1;

saveSidebarCollapsed:
UPDATE app_settings SET is_sidebar_collapsed = ? WHERE id = 1;

saveWindowMaximized:
UPDATE app_settings SET is_window_maximized = ? WHERE id = 1;

saveWindowBounds:
UPDATE app_settings SET is_window_maximized = 0, window_x = ?, window_y = ?, window_width = ?, window_height = ? WHERE id = 1;
