CREATE TABLE apply_result (
    template_bike_id INTEGER NOT NULL PRIMARY KEY REFERENCES template_bike(id) ON DELETE CASCADE,
    applied_at_epoch_millis INTEGER NOT NULL,
    simulator_id INTEGER NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    target_state TEXT,
    target_percent REAL,
    availability TEXT NOT NULL,
    disabled_reason_name TEXT,
    disabled_reason_title TEXT,
    status_json TEXT NOT NULL,
    CHECK ((target_state IS NULL) <> (target_percent IS NULL))
);
