CREATE TABLE apply_result (
    template_bike_id INTEGER NOT NULL PRIMARY KEY REFERENCES template_bike(id) ON DELETE CASCADE,
    applied_at_epoch_millis INTEGER NOT NULL,
    simulator_id INTEGER NOT NULL,
    latitude REAL NOT NULL,
    longitude REAL NOT NULL,
    target_state TEXT,
    target_percent REAL,
    availability TEXT NOT NULL,
    disabled_reason_name TEXT,
    disabled_reason_title TEXT,
    status_json TEXT NOT NULL,
    CHECK ((target_state IS NULL) <> (target_percent IS NULL))
);

selectResultsForStand:
SELECT apply_result.*
FROM apply_result
JOIN template_bike ON template_bike.id = apply_result.template_bike_id
JOIN template ON template.id = template_bike.template_id
WHERE template.stand_base_url = ?;

saveResult:
INSERT OR REPLACE INTO apply_result(
    template_bike_id, applied_at_epoch_millis, simulator_id, latitude, longitude, target_state, target_percent,
    availability, disabled_reason_name, disabled_reason_title, status_json
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
