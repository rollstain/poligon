CREATE TABLE setup_defaults (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    target_state TEXT,
    target_percent REAL,
    availability TEXT NOT NULL,
    disabled_reason_name TEXT,
    disabled_reason_title TEXT,
    CHECK ((target_state IS NULL) <> (target_percent IS NULL))
);

selectDefaults:
SELECT * FROM setup_defaults WHERE id = 1;

saveDefaults:
INSERT OR REPLACE INTO setup_defaults(id, target_state, target_percent, availability, disabled_reason_name, disabled_reason_title)
VALUES (1, ?, ?, ?, ?, ?);
